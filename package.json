{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered developer workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta,yellow\" \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:worker\"",
    "build": "npm run build --workspace=@forge/web",
    "dev:api": "npm run dev --workspace=@forge/api",
    "dev:web": "npm run dev --workspace=@forge/web",
    "dev:worker": "npm run dev --workspace=@forge/worker",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
